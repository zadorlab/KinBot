+// Diagnostic export of native, unreduced energy-grained transitions.
+// Entries are outgoing rates in s^-1; no eigensystem or species reduction.
+// Diagonals are exported independently for conservation checks, not reconstructed here.
+#include <iomanip>
+#include <limits>
+static void export_energy_grained_generator(const std::string& path) {
+  using namespace MasterEquation;
+  std::ofstream out(path.c_str(), std::ios::app);
+  if(!out) throw Error::Open();
+  out << std::setprecision(17);
+  out << "BEGIN 1 " << temperature()/Phys_const::kelv << " " << pressure()/Phys_const::atm
+      << " " << energy_step()/Phys_const::kcal << "\n";
+  std::vector<int> shift(Model::well_size()+1, 0);
+  for(int w=0; w<Model::well_size(); ++w) shift[w+1]=shift[w]+well(w).size();
+  for(int w=0; w<Model::well_size(); ++w) {
+    for(int e=0; e<well(w).size(); ++e) {
+      const double b=well(w).boltzman_sqrt(e);
+      out << "STATE " << shift[w]+e << " " << Model::well(w).short_name() << " " << e
+          << " " << (energy_reference()-e*energy_step())/Phys_const::kcal << " " << b << " " << well(w).state_density(e) << "\n";
+      out << "COLLISION_DIAGONAL " << shift[w]+e << " " << well(w).kernel(e,e)*well(w).collision_frequency()/Phys_const::herz << "\n";
+      const int lo=std::max(0,e-well(w).kernel_bandwidth+1);
+      const int hi=std::min(well(w).size(),e+well(w).kernel_bandwidth);
+      for(int f=lo;f<hi;++f) if(f!=e && well(w).kernel(e,f)!=0.)
+        out << "EDGE " << shift[w]+e << " " << shift[w]+f << " "
+            << -well(w).kernel(e,f)*well(w).collision_frequency()/Phys_const::herz << " collision\n";
+      if(well(w).radiation()) throw Error::Init(); // Do not silently omit a radiative model.
+    }
+  }
+  for(int b=0;b<Model::inner_barrier_size();++b) {
+    const int w1=Model::inner_connect(b).first,w2=Model::inner_connect(b).second;
+    for(int e=0;e<inner_barrier(b).size();++e) {
+      const double flux=inner_barrier(b).state_number(e)/(2.*M_PI*Phys_const::herz);
+      out << "EDGE " << shift[w1]+e << " " << shift[w2]+e << " " << flux/well(w1).state_density(e) << " reaction\n";
+      out << "EDGE " << shift[w2]+e << " " << shift[w1]+e << " " << flux/well(w2).state_density(e) << " reaction\n";
+    }
+  }
+  for(int b=0;b<Model::outer_barrier_size();++b) {
+    const int w=Model::outer_connect(b).first,p=Model::outer_connect(b).second;
+    for(int e=0;e<outer_barrier(b).size();++e)
+      out << "SINK " << shift[w]+e << " " << Model::bimolecular(p).short_name() << " "
+          << outer_barrier(b).state_number(e)/(2.*M_PI*well(w).state_density(e)*Phys_const::herz) << "\n";
+  }
+  for(int s=0;s<Model::escape_size();++s) {
+    const int w=Model::escape_channel(s).first,channel=Model::escape_channel(s).second;
+    for(int e=0;e<well(w).size();++e)
+      out << "SINK " << shift[w]+e << " " << Model::escape_name(s) << " "
+          << Model::well(w).escape_rate((energy_reference()-e*energy_step()),channel)/Phys_const::herz << "\n";
+  }
+  out << "END\n";
+  if(!out) throw Error::Open();
+}
